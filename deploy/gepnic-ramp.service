[Unit]
Description=Measure how much load each GePNIC portal server takes (capacity ramp)
After=postgresql.service

[Service]
Type=oneshot
User=gepnic
WorkingDirectory=/opt/gepnic
EnvironmentFile=/etc/gepnic-app/env
ExecStart=/opt/gepnic/.venv/bin/python jobs/ramp.py
TimeoutStartSec=1800
NoNewPrivileges=true
